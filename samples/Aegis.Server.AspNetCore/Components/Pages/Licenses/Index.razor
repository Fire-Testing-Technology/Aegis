@page "/licenses"
@attribute [Authorize(Roles = "Admin,User")]
@using System.Security.Claims
@using System.Text
@using Aegis.Enums
@using Aegis.Models
@using Aegis.Server.AspNetCore.Data.Context
@using Aegis.Server.AspNetCore.Utilities
@using Aegis.Server.DTOs
@using Aegis.Server.Entities
@using Aegis.Server.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject LicenseService LicenseService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime Js

<PageTitle>Licences</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Licences</h1>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <button type="button" class="btn btn-outline-secondary" @onclick="ExportCsvAsync" disabled="@_busy">
            Export CSV
        </button>
        <AuthorizeView Roles="Admin">
            <label class="btn btn-outline-secondary mb-0 @( _busy ? "disabled" : null )">
                Import CSV
                <InputFile OnChange="ImportCsvAsync" accept=".csv,text/csv" class="d-none" disabled="@_busy" />
            </label>
            <a class="btn btn-primary" href="licenses/generate">Generate licence</a>
        </AuthorizeView>
    </div>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-info" style="white-space: pre-wrap;">@_message</div>
}

@if (_licenses.Count == 0)
{
    <div class="alert alert-secondary">No licences issued yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Licence key</th>
                    <th>Product</th>
                    <th>Type</th>
                    <th>Issued to</th>
                    <th>Status</th>
                    <th>Expires</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var license in _licenses)
                {
                    <tr>
                        <td><code class="small">@license.LicenseKey</code></td>
                        <td>@license.Product?.ProductName</td>
                        <td>@license.Type</td>
                        <td>@license.IssuedTo</td>
                        <td>
                            <span class="badge @StatusBadgeClass(license.Status)">@license.Status</span>
                        </td>
                        <td>@(license.ExpirationDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-info me-1" href="licenses/@license.LicenseId">View</a>
                            <button class="btn btn-sm btn-outline-primary me-1"
                                    @onclick="() => DownloadAsync(license)">Download</button>
                            <button class="btn btn-sm btn-outline-secondary me-1"
                                    @onclick="() => CopyBase64Async(license)">Copy Base64</button>
                            <AuthorizeView Roles="Admin" Context="revokeContext">
                                <Authorized>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => RevokeAsync(license)">Revoke</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<License> _licenses = [];
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _licenses = await Db.Licenses
            .Include(l => l.Product)
            .OrderByDescending(l => l.IssuedOn)
            .ToListAsync();
    }

    private static string StatusBadgeClass(LicenseStatus status) => status switch
    {
        LicenseStatus.Valid => "text-bg-success",
        LicenseStatus.Expired => "text-bg-warning",
        LicenseStatus.Revoked => "text-bg-danger",
        _ => "text-bg-secondary"
    };

    private async Task DownloadAsync(License license)
    {
        try
        {
            var bytes = await RegenerateFileAsync(license);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"{license.Product?.ProductName?.Replace(' ', '-') ?? "licence"}-{license.LicenseKey[..8]}.bin";
            await Js.InvokeVoidAsync("aegisDownloadFile", fileName, base64);
            _message = $"Downloaded licence file for {license.LicenseKey}.";
        }
        catch (Exception ex)
        {
            _message = $"Download failed: {ex.Message}";
        }
    }

    private async Task CopyBase64Async(License license)
    {
        try
        {
            var bytes = await RegenerateFileAsync(license);
            var base64 = Convert.ToBase64String(bytes);
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", base64);
            _message = "Licence Base64 copied to clipboard.";
        }
        catch (Exception ex)
        {
            _message = $"Copy failed: {ex.Message}";
        }
    }

    private async Task RevokeAsync(License license)
    {
        var result = await LicenseService.RevokeLicenseAsync(license.LicenseKey);
        _message = result.IsSuccessful ? $"Revoked {license.LicenseKey}." : result.Exception?.Message ?? "Revoke failed.";
        await LoadAsync();
    }

    private async Task<byte[]> RegenerateFileAsync(License license)
    {
        return await LicenseService.GetLicenseFileBytesAsync(license.LicenseId);
    }

    private async Task ExportCsvAsync()
    {
        try
        {
            await LoadAsync();

            var csv = LicensesCsv.Build(_licenses.Select(l => (
                l.LicenseKey,
                l.Product?.ProductName ?? string.Empty,
                l.Product?.SoftwareUrn ?? string.Empty,
                l.Type.ToString(),
                l.IssuedTo ?? string.Empty,
                l.Issuer ?? string.Empty,
                l.Status.ToString(),
                l.IssuedOn.ToUniversalTime().ToString("O"),
                l.ExpirationDate?.ToUniversalTime().ToString("O") ?? string.Empty)));

            var bytes = WithUtf8Bom(Encoding.UTF8.GetBytes(csv));
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"licences-{DateTime.UtcNow:yyyyMMdd-HHmm}.csv";
            await Js.InvokeVoidAsync("aegisDownloadFile", fileName, base64);
            _message = "Exported licences to CSV.";
        }
        catch (Exception ex)
        {
            _message = $"CSV export failed: {ex.Message}";
        }
    }

    private async Task ImportCsvAsync(InputFileChangeEventArgs e)
    {
        _busy = true;
        _message = null;

        try
        {
            var file = e.File;
            if (file == null)
            {
                _message = "No CSV file selected.";
                return;
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
            var csvText = await reader.ReadToEndAsync();

            var rows = LicensesCsv.Parse(csvText);
            var issuerId = await ResolveIssuingUserIdAsync();
            var products = await Db.Products.Include(p => p.Features).ToListAsync();

            var created = 0;
            var skipped = 0;
            var errors = new List<string>();

            foreach (var row in rows)
            {
                try
                {
                    if (!string.IsNullOrWhiteSpace(row.LicenseKey)
                        && await Db.Licenses.AnyAsync(l => l.LicenseKey == row.LicenseKey))
                    {
                        skipped++;
                        continue;
                    }

                    var product = ResolveProduct(products, row);
                    if (product == null)
                    {
                        errors.Add($"Line {row.LineNumber}: product not found (Product='{row.Product}', SoftwareUrn='{row.SoftwareUrn}').");
                        continue;
                    }

                    string? hardwareId = row.HardwareId;
                    if (row.Type == LicenseType.NodeLocked)
                    {
                        if (string.IsNullOrWhiteSpace(hardwareId) && !string.IsNullOrWhiteSpace(row.RequestCode))
                            hardwareId = MachineIdEncoding.DecodeRequestCodePayload(row.RequestCode).MachineId;

                        if (string.IsNullOrWhiteSpace(hardwareId))
                        {
                            errors.Add($"Line {row.LineNumber}: NodeLocked requires HardwareId or RequestCode.");
                            continue;
                        }
                    }

                    if (row.Type is LicenseType.Concurrent or LicenseType.Floating
                        && row.MaxActiveUsersCount is null or < 1)
                    {
                        errors.Add($"Line {row.LineNumber}: {row.Type} requires MaxActiveUsersCount.");
                        continue;
                    }

                    var request = new LicenseGenerationRequest
                    {
                        LicenseType = row.Type,
                        ProductId = product.ProductId,
                        IssuedTo = row.IssuedTo,
                        ExpirationDate = row.Type == LicenseType.Trial ? null : row.ExpiresUtc,
                        HardwareId = hardwareId,
                        MaxActiveUsersCount = row.MaxActiveUsersCount,
                        IssuingUserId = issuerId,
                        Features = product.Features.ToDictionary(
                            f => f.FeatureId,
                            _ => Aegis.Models.Feature.FromBool(true))
                    };

                    if (row.Type == LicenseType.Trial)
                    {
                        TimeSpan? trialDuration = null;
                        if (row.IssuedOnUtc is { } issued && row.ExpiresUtc is { } ends && ends > issued)
                            trialDuration = ends - issued;
                        else if (row.ExpiresUtc is { } endsOnly && endsOnly > DateTime.UtcNow)
                            trialDuration = endsOnly - DateTime.UtcNow;

                        if (trialDuration is null || trialDuration <= TimeSpan.Zero)
                        {
                            errors.Add(
                                $"Line {row.LineNumber}: Trial requires IssuedOnUtc+ExpiresUtc (duration) or a future ExpiresUtc.");
                            continue;
                        }

                        request.TrialDuration = trialDuration;
                    }

                    if (row.Type == LicenseType.Subscription && row.ExpiresUtc is { } expires)
                    {
                        var duration = expires - DateTime.UtcNow;
                        if (duration <= TimeSpan.Zero)
                        {
                            errors.Add($"Line {row.LineNumber}: subscription ExpiresUtc must be in the future.");
                            continue;
                        }

                        request.SubscriptionDuration = duration;
                    }

                    await LicenseService.GenerateLicenseAsync(request);
                    created++;
                }
                catch (Exception ex)
                {
                    errors.Add($"Line {row.LineNumber}: {ex.Message}");
                }
            }

            await LoadAsync();

            var summary = $"CSV import finished. Created: {created}. Skipped (existing key): {skipped}. Failed: {errors.Count}.";
            if (errors.Count > 0)
                summary += "\n" + string.Join("\n", errors.Take(20));
            if (errors.Count > 20)
                summary += $"\n… and {errors.Count - 20} more.";

            _message = summary;
        }
        catch (Exception ex)
        {
            _message = $"CSV import failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private static Product? ResolveProduct(List<Product> products, LicensesCsv.ImportRow row)
    {
        if (!string.IsNullOrWhiteSpace(row.SoftwareUrn))
        {
            var byUrn = products.FirstOrDefault(p =>
                string.Equals(p.SoftwareUrn, row.SoftwareUrn, StringComparison.OrdinalIgnoreCase));
            if (byUrn != null)
                return byUrn;
        }

        if (!string.IsNullOrWhiteSpace(row.Product))
        {
            return products.FirstOrDefault(p =>
                string.Equals(p.ProductName, row.Product, StringComparison.OrdinalIgnoreCase));
        }

        return null;
    }

    private async Task<Guid> ResolveIssuingUserIdAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (Guid.TryParse(idClaim, out var claimId)
            && await Db.Users.AnyAsync(u => u.Id == claimId))
        {
            return claimId;
        }

        var username = auth.User.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(username))
        {
            var userId = await Db.Users
                .Where(u => u.Username == username)
                .Select(u => (Guid?)u.Id)
                .FirstOrDefaultAsync();
            if (userId.HasValue)
                return userId.Value;
        }

        throw new InvalidOperationException(
            "Could not resolve the signed-in user in the database. Sign out and sign in again.");
    }

    private static byte[] WithUtf8Bom(byte[] bytes)
    {
        var preamble = Encoding.UTF8.GetPreamble();
        if (preamble.Length == 0) return bytes;

        var withBom = new byte[preamble.Length + bytes.Length];
        Buffer.BlockCopy(preamble, 0, withBom, 0, preamble.Length);
        Buffer.BlockCopy(bytes, 0, withBom, preamble.Length, bytes.Length);
        return withBom;
    }
}

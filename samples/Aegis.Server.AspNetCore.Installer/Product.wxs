<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
	<!-- Distinct UpgradeCode for Aegis AspNetCore web/service MSI -->
	<Product Id="*" Name="$(var.ApplicationFullName)" Language="1033" Version="$(var.FullSafeVersion)" Manufacturer="$(var.FullCompany)" UpgradeCode="d2f8a1c4-5e7b-4a9c-8d16-0b3e5f7a9c21">
		<Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Platform="$(var.PackagePlatform)"/>

		<MajorUpgrade
			AllowSameVersionUpgrades="yes"
			IgnoreRemoveFailure="no"
			Schedule="afterInstallInitialize"
			DowngradeErrorMessage="A newer version of $(var.ApplicationLongName) is already installed."/>

		<MediaTemplate EmbedCab="yes"/>

		<Icon Id="ProductIcon" SourceFile="ftt_icon.ico" />
		<Property Id="ARPPRODUCTICON" Value="ProductIcon" />

		<Feature Id="ProductFeature" Title="$(var.ApplicationFullName) [$(var.PackagePlatform)]" Level="1">
			<!--PublishFiles.g.wxs is produced by heat.exe during build; ServiceInstall is injected via HeatTransform.xslt-->
			<ComponentGroupRef Id="PublishFiles" />
			<ComponentRef Id="StartMenuShortcut" />
			<ComponentRef Id="DesktopShortcut" />
		</Feature>

		<WixVariable Id="WixUIBannerBmp" Value="Banner.bmp" />
		<WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

		<UI>
			<UIRef Id="WixUI_Minimal" />
			<UIRef Id="WixUI_ErrorProgressText" />
		</UI>
	</Product>

	<Fragment>
		<Directory Id="TARGETDIR" Name="SourceDir">

			<?if $(var.PackagePlatform) = x64 ?>
			<Directory Id="ProgramFiles64Folder">
				<Directory Id="CompanyInstallFolder" Name="$(var.LongCompany)">
					<Directory Id="ProductInstallFolder" Name="$(var.ApplicationShortName)">
						<Directory Id="MajorVersionInstallFolder" Name="$(var.MajorVersion)">
							<Directory Id="INSTALLFOLDER" Name="$(var.MinorFolderVersion)" />
						</Directory>
					</Directory>
				</Directory>
			</Directory>
			<?else ?>
			<Directory Id="ProgramFilesFolder">
				<Directory Id="CompanyInstallFolder" Name="$(var.LongCompany)">
					<Directory Id="ProductInstallFolder" Name="$(var.ApplicationShortName)">
						<Directory Id="MajorVersionInstallFolder" Name="$(var.MajorVersion)">
							<Directory Id="INSTALLFOLDER" Name="$(var.MinorFolderVersion)" />
						</Directory>
					</Directory>
				</Directory>
			</Directory>
			<?endif ?>

			<Directory Id="ProgramMenuFolder">
				<Directory Id="ApplicationProgramsCompanyFolder" Name="$(var.LongCompany)">
					<Directory Id="ApplicationProgramsFolder" Name="$(var.ApplicationLongName)" />
				</Directory>
			</Directory>

			<Directory Id="DesktopFolder" />
		</Directory>
	</Fragment>

	<Fragment>
		<DirectoryRef Id="ApplicationProgramsFolder">
			<Component Id="StartMenuShortcut" Guid="{A1B3C5D7-E9F0-4A2B-8C1D-3E5F7A9B0C2D}">
				<!-- Opens the Blazor UI hosted by the Windows service -->
				<Shortcut
					Id="StartMenuShortcut"
					Name="$(var.ApplicationLongName)"
					Description="Open $(var.ApplicationFullName) UI"
					Target="$(var.ApplicationUrl)"
					WorkingDirectory="INSTALLFOLDER" />

				<RemoveFolder
					Id="RemoveApplicationProgramsFolder"
					On="uninstall" />

				<RegistryValue
					Root="HKLM"
					Key="Software\FTT\$(var.ApplicationLongName)"
					Name="StartShortcutInstalled"
					Type="integer"
					Value="1"
					KeyPath="yes" />
			</Component>
		</DirectoryRef>
	</Fragment>

	<Fragment>
		<DirectoryRef Id="DesktopFolder">
			<Component Id="DesktopShortcut" Guid="{B2C4D6E8-F0A1-4B3C-9D2E-4F6A8B0C1D3E}">
				<Shortcut
					Id="DesktopShortcut"
					Name="$(var.ApplicationLongName)"
					Description="Open $(var.ApplicationFullName) UI"
					Target="$(var.ApplicationUrl)"
					WorkingDirectory="INSTALLFOLDER"
					Advertise="no" />

				<RemoveFolder
					Id="RemoveDesktopShortcut"
					On="uninstall" />

				<RegistryValue
					Root="HKLM"
					Key="Software\FTT\$(var.ApplicationLongName)"
					Name="DesktopShortcutInstalled"
					Type="integer"
					Value="1"
					KeyPath="yes" />
			</Component>
		</DirectoryRef>
	</Fragment>

</Wix>
